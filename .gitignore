artifacts/runs/logs/
artifacts/runs/**/adapter/
artifacts/runs/**/*.pt
artifacts/runs/**/*.safetensors
artifacts/runs/**/train_log.jsonl

# --- model checkpoints (large, regenerable) ---
artifacts/runs/
artifacts/eval/
artifacts/datasets/

