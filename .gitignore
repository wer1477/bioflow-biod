.venv/
venv/
.hf_cache/
.tmp/

# --- secrets ---
.env
*.env
!*.env.example

# --- RSI research: third-party clones + runtime ---
RSI/.venv/
RSI/code/
RSI/logs/

# --- execution sandbox / remote-only state ---
other/
artifacts_zero_training/

# --- DevLog is local-only (AGENTS.md) ---
DevLog/

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
*.swp

# --- kb_baseline runtime caches (embeddings) ---
kb_baseline/v1/results/cache/
*.npz

# --- kb_baseline runtime outputs not committed (regenerable) ---
kb_baseline/v1/results/raw/
kb_baseline/v1/results/logs/

# --- toollibrary baseline runtime outputs (regenerable) ---
toollibrary_baseline/v1/results/raw/
toollibrary_baseline/v1/results/logs/

